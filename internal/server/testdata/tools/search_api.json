{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true,
    "title": "Search Moodle API"
  },
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "format": {
        "description": "'text' (default) for Markdown, 'json' for a structured response",
        "enum": [
          "",
          "text",
          "json"
        ],
        "type": "string"
      },
      "limit": {
        "description": "Max results, 1-100 (default 30)",
        "type": "integer"
      },
      "query": {
        "description": "Search term (function name, keyword in summary, etc.)",
        "type": "string"
      },
      "visibility": {
        "description": "'public' (default), 'deprecated', or 'all'",
        "enum": [
          "",
          "public",
          "deprecated",
          "all"
        ],
        "type": "string"
      }
    },
    "required": [
      "query"
    ],
    "type": "object"
  },
  "name": "search_api",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "fuzzy": {
        "description": "True when no exact match existed and the matches come from fuzzy matching",
        "type": "boolean"
      },
      "matches": {
        "description": "Matching function entries of the API index, as Markdown list items",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "query": {
        "description": "The query that was searched",
        "type": "string"
      },
      "visibility": {
        "description": "Visibility filter applied: public, deprecated or all",
        "type": "string"
      }
    },
    "required": [
      "query",
      "visibility",
      "fuzzy",
      "matches"
    ],
    "type": "object"
  }
}
