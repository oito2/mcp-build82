{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true,
    "title": "Search Plugins"
  },
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "format": {
        "description": "'text' (default) for Markdown, 'json' for a structured response",
        "enum": [
          "",
          "text",
          "json"
        ],
        "type": "string"
      },
      "limit": {
        "description": "Max results, 1-100 (default 20)",
        "type": "integer"
      },
      "query": {
        "description": "Search term (component name, plugin type, etc.)",
        "type": "string"
      }
    },
    "required": [
      "query"
    ],
    "type": "object"
  },
  "name": "search_plugins",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "fuzzy": {
        "description": "True when no exact match existed and the matches come from fuzzy matching",
        "type": "boolean"
      },
      "matches": {
        "description": "Matching rows of the plugin index, as Markdown table rows (Component | Type | Name | Version | Path)",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "query": {
        "description": "The query that was searched",
        "type": "string"
      }
    },
    "required": [
      "query",
      "fuzzy",
      "matches"
    ],
    "type": "object"
  }
}
